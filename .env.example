# Copy this file to ".env" and fill in real values. Never commit ".env".

# Required in production. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=replace-with-a-long-random-string

# "True" only on your own machine. Leave "False" everywhere else.
DEBUG=False

# Comma-separated host names this site may be served from.
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins (with scheme) trusted for POST requests.
CSRF_TRUSTED_ORIGINS=https://your-app-name.herokuapp.com

# Leave unset to use a local SQLite file. Examples:
#   postgres://USER:PASSWORD@HOST:5432/DBNAME
#   mysql://USER:PASSWORD@HOST:3306/DBNAME   (also install "mysqlclient")
DATABASE_URL=
DATABASE_SSL_REQUIRE=False

# HTTPS hardening. Defaults to the opposite of DEBUG when unset.
SECURE_SSL_REDIRECT=False

# Optional: store uploaded product images on Amazon S3 (needed on Heroku,
# whose file system is wiped on every restart).
USE_AWS=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=eu-west-2

# Store settings (pounds sterling).
FREE_DELIVERY_THRESHOLD=50.00
STANDARD_DELIVERY_COST=4.99
